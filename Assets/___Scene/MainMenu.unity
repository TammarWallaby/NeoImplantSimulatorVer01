    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 60
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\uB9C8\uCDE8: \uBD80\uBD84 \uB9C8\uCDE8\uB97C \uD1B5\uD574 \uC2DC\uC220
    \uBD80\uC704\uC758 \uD1B5\uC99D\uC744 \uC5C6\uC571\uB2C8\uB2E4.\r\n\uC787\uBAB8
    \uC808\uAC1C \uBC0F \uBC15\uB9AC: \uC77C\uBC18\uC801\uC778 \uC784\uD50C\uB780\uD2B8
    \uC2DC\uC220\uC5D0\uC11C\uB294 \uC787\uBAB8\uC744 \uC808\uAC1C\uD558\uACE0 \uBC15\uB9AC\uD574
    \uC787\uBAB8\uC744 \uC5F4\uC5B4 \uB4DC\uB9B4\uC744 \uD1B5\uD574 \uBF08\uC5D0
    \uC811\uADFC\uD560 \uC218 \uC788\uB3C4\uB85D \uD569\uB2C8\uB2E4.\r\n\n\uC808\uAC1C
    \uC5C6\uC774 \uC9C4\uD589: \uB9CC\uC57D 3D \uC2A4\uCE90\uB108\uC640 \uC5D1\uC2A4\uB808\uC774\uB97C
    \uD1B5\uD574 \uC218\uC220\uC6A9 \uAC00\uC774\uB4DC(\uBCF4\uD615\uBB3C)\uB97C
    \uC81C\uC791\uD55C \uACBD\uC6B0, \uC808\uAC1C \uC5C6\uC774 \uC787\uBAB8\uC744
    \uB6AB\uB294 \uBD80\uBD84\uB9CC \uAD6C\uBA4D\uC744 \uB0B4\uC11C \uC9C1\uC811
    \uC9C4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC774\uB294 \uAE4A\uAC8C
    \uB6AB\uB294 \uC2E4\uC218\uB97C \uC904\uC774\uACE0 \uC548\uC804\uD55C \uC808\uCC28\uB97C
    \uB3C4\uC640\uC90D\uB2C8\uB2E4."
