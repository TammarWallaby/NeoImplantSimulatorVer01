      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 40
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 4
    m_MaxSize: 55
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\uD06C\uB77C\uC6B4 \uC7A5\uCC29\n\uC5B4\uBC84\uD2B8\uBA3C\uD2B8 \uC704\uC5D0
    \uC778\uACF5 \uCE58\uC544\uC778 \uD06C\uB77C\uC6B4\uC744 \uC50C\uC6C1\uB2C8\uB2E4.
    \uD06C\uB77C\uC6B4\uC740 \uD658\uC790\uC758 \uBCF8\uB798 \uCE58\uC544\uCC98\uB7FC
    \uBCF4\uC774\uB3C4\uB85D \uB9DE\uCDA4 \uC81C\uC791\uB418\uBA70, \uC5B4\uBC84\uD2B8\uBA3C\uD2B8\uC5D0
    \uACAC\uACE0\uD558\uAC8C \uACE0\uC815\uB429\uB2C8\uB2E4.\r\n\n\uD06C\uB77C\uC6B4
    \uC77C\uCCB4\uD615 \uC5B4\uBC84\uD2B8\uBA3C\uD2B8\n\uC5B4\uBC84\uD2B8\uBA3C\uD2B8\uC640
    \uD06C\uB77C\uC6B4\uC774 \uD558\uB098\uB85C \uD1B5\uD569\uB41C \uD615\uD0DC\uC77C
    \uACBD\uC6B0, \uC774\uB97C \uB098\uC0AC\uB97C \uC774\uC6A9\uD574 \uD53D\uC2A4\uCC98\uC5D0
    \uBC14\uB85C \uC7A5\uCC29\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
