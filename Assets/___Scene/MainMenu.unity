  m_Text: "(\uD06C\uB77C\uC6B4\uACFC \uD53D\uC2A4\uCC98 \uC5F0\uACB0\uBD80)\n\n\uD790\uB9C1
    \uC5B4\uBC84\uD2B8\uBA3C\uD2B8\uB97C \uC81C\uAC70\uD55C \uD6C4, \"\uC5B4\uBC84\uD2B8\uBA3C\uD2B8(Abutment)\"\uB97C
    \uD53D\uC2A4\uCC98\uC5D0 \uC5F0\uACB0\uD569\uB2C8\uB2E4. \uC5B4\uBC84\uD2B8\uBA3C\uD2B8\uB294
