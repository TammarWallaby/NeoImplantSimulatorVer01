    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 60
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "(\uB9C8\uCC30\uC5F4 \uBC29\uC9C0\uC6A9 \uBB3C\uC774 \uB098\uC634)\r\n\n\uB4DC\uB9B4
    \uC21C\uC11C: \uC791\uC740 \uB4DC\uB9B4\uB85C \uC2DC\uC791\uD574 \uC810\uCC28
    \uD070 \uB4DC\uB9B4\uB85C \uAD6C\uBA4D\uC744 \uB113\uD600\uAC00\uBA70, \uBF08\uC5D0
    \uC815\uD655\uD55C \uC704\uCE58\uC5D0 \uAD6C\uBA4D\uC744 \uB6AB\uC2B5\uB2C8\uB2E4.
    \uB4DC\uB9B4\uB9C1 \uACFC\uC815\uC5D0\uC11C \uACFC\uB3C4\uD55C \uB9C8\uCC30\uC5F4\uC774
    \uBC1C\uC0DD\uD558\uC9C0 \uC54A\uB3C4\uB85D \uBB3C\uC744 \uC0AC\uC6A9\uD574 \uB0C9\uAC01\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\n\uC2E0\uACBD
    \uBCF4\uD638: \uC2E0\uACBD\uC744 \uAC74\uB4DC\uB9AC\uC9C0 \uC54A\uB3C4\uB85D
    \uC704\uCE58\uB97C \uC815\uD655\uD788 \uC7A1\uACE0 \uC870\uC2EC\uC2A4\uB7FD\uAC8C
    \uB6AB\uC5B4\uC57C \uD569\uB2C8\uB2E4."
